{
  "info": {
    "_postman_id": "6a0c5f3e-8b1d-4c7a-9e2f-3d4b5a6c7e81",
    "name": "post-tech-restaurant",
    "description": "Collection da Restaurant API (Tech Challenge Fase 2).\n\nOrdem sugerida num banco limpo: User > Create Owner User, Create Employee User, Login; Restaurant > Create Restaurant; Item > Create Item; Order > Create Order.\n\nOs scripts de teste salvam token e IDs nas variáveis da collection, usadas pelas demais requisições.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "1" },
    { "key": "employeeId", "value": "2" },
    { "key": "restaurantId", "value": "1" },
    { "key": "itemId", "value": "1" },
    { "key": "orderId", "value": "1" }
  ],
  "item": [
    {
      "name": "User",
      "item": [
        {
          "name": "Create Owner User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set(\"userId\", pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maria Owner\",\n  \"email\": \"maria.owner@email.com\",\n  \"login\": \"maria.owner\",\n  \"phone\": \"11987654321\",\n  \"password\": \"welcome123\",\n  \"address\": {\n    \"street\": \"Av. Paulista\",\n    \"number\": \"1106\",\n    \"neighborhood\": \"Bela Vista\",\n    \"city\": \"São Paulo\",\n    \"state\": \"SP\",\n    \"zipCode\": \"01311000\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
            "description": "Cadastro público. Salva o id em userId."
          }
        },
        {
          "name": "Create Employee User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set(\"employeeId\", pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Joao Employee\",\n  \"email\": \"joao.employee@email.com\",\n  \"login\": \"joao.employee\",\n  \"phone\": \"11987654322\",\n  \"password\": \"welcome123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
            "description": "Segundo usuário, usado como funcionário. Salva o id em employeeId."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set(\"token\", pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"maria.owner\",\n  \"password\": \"welcome123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Autentica e salva o JWT em token."
          }
        },
        {
          "name": "Get Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        },
        {
          "name": "Get User by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] }
          }
        },
        {
          "name": "Get Users by Name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/name/Maria%20Owner?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["users", "name", "Maria%20Owner"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "Busca paginada por nome exato (sem diferenciar maiúsculas)."
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"11911112222\",\n  \"address\": {\n    \"number\": \"2000\",\n    \"complement\": \"Sala 10\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] },
            "description": "Atualiza apenas os campos enviados (email, login, phone, address)."
          }
        },
        {
          "name": "Update User Password",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"welcome456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/me/password", "host": ["{{baseUrl}}"], "path": ["users", "me", "password"] },
            "description": "Depois desta chamada, faça login com a nova senha."
          }
        },
        {
          "name": "Delete User (soft delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] },
            "description": "Desativa a conta do usuário autenticado; ele não consegue mais fazer login."
          }
        }
      ]
    },
